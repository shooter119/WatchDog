        "municipalHydrants",
        "firePumps",
        "escapeRoutes",
        "extinguishingAgents",
        "notes"
      ],
      "help": "系统按原文记录有、无或待核对；数量、流量、扬程和一用一备关系不得合并丢失。"
    },
    "processFlow": {
      "module": "cards",
      "label": "工艺流程",
      "fields": [
        "processFlow",
        "confidentiality",
        "notes"
      ],
