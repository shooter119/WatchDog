        "warehouseName",
        "location",
        "composition",
        "buildingStructure",
        "buildingArea",
        "storageForm",
        "packageCapacity",
        "quantity",
        "risk",
        "storage",
        "notes"
      ],
      "help": "每种存货一条，以品名为标题；单位包装储量与总储量分开，合并单元格信息须人工核对。"
    },
    "storageTank": {
