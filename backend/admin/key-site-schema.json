      "help": "每个储罐一条；标题保留介质名称与编号。容积不代表实际储量，直径和高度保留原单位。"
    },
    "contact": {
      "module": "organization",
      "label": "单位联系人",
      "fields": [
        "position",
        "contact",
        "phone",
        "responsibilities",
        "parent",
        "notes"
      ],
      "help": "每个岗位或联系人一条；相同人员兼任不同岗位时分别保留，未提供电话不得补造。"
    }
  },
  "rules": [
    "名称、地址与档案核对；草稿不自动改写档案。",
    "每套装置、每种仓库存货、每个储罐和每个联系人分别记录。",
    "未知留空；原文“/”、约数、涉密说明及计量单位保留，待人工核对。",
    "设计容积、单位包装储量、实际储量分别记录，不做换算或推断。",
    "所有记录沿用出处、人工核对、草稿和版本发布流程。"
  ]
}
