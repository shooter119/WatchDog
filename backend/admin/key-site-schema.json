        "chemicals",
        "dangerousProcess",
        "fixedFireFacilities",
        "fireResistance",
        "floorsAndHeight",
        "risk",
        "notes"
      ],
      "help": "每套工艺装置一条，以装置名称为标题；未知危险工艺不得推定为无。"
    },
    "fireProtection": {
      "module": "cards",
