# ========== 豆包语音（火山引擎）==========
# 新版控制台创建应用后获取 APP Key：https://console.volcengine.com/speech/new
# 开通「语音识别大模型 - 流式语音识别」后，Resource ID 选择小时版 volc.bigasr.sauc.duration
VOLC_APP_KEY=
VOLC_ACCESS_TOKEN=
VOLC_RESOURCE_ID=volc.bigasr.sauc.duration

# ========== DeepSeek ==========
# https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 生产环境允许访问的 DeepSeek 主机，逗号分隔；自定义代理/兼容服务必须显式填写
WATCHDOG_LLM_ALLOWED_HOSTS=api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 辅助问答专用模型（Responses API，支持服务端联网搜索；目前仅 deepseek-v4-flash）
DEEPSEEK_CHAT_MODEL=deepseek-flash
# 警情文字/图片导入专用模型：只需照抄原文，不需要推理。
# 留空默认 deepseek-chat；填带隐式思考的模型会让单次导入从 ~2 秒涨到 20-30 秒。
IMPORT_MODEL=deepseek-chat
# 辅助问答联网搜索开关：1 开启（默认），0 关闭
CHAT_SEARCH_ENABLED=1

# ========== 高德 Web 服务（水印相机地址与天气）==========
# 仅支持「Web 服务」类型 Key，不要使用 Android/iOS/JS API 的 Key。
# https://console.amap.com/dev/key/app 免费申请；逆地理编码与天气查询个人开发者有免费月配额。
# Key 只保存在服务端，App 通过 /api/weather 间接使用，不会下发到客户端。
# 未配置时 /api/weather 返回 503 AMAP_NOT_CONFIGURED，客户端水印降级为仅显示经纬度。
AMAP_KEY=

# ========== 标准 PostgreSQL 17 ==========
# 本地推荐使用 Homebrew PostgreSQL；生产可使用任意标准 PostgreSQL 17 服务。
WATCHDOG_DB_DRIVER=postgres
DATABASE_URL=postgresql:///watchdog_dev
DATABASE_POOL_MAX=10
DATABASE_SSL=0

# ========== 计算参数 ==========
# 气瓶容量(升)、满压(兆帕)、中等劳动强度消耗率(升/分钟)
CYLINDER_VOL_L=6.8
FULL_PRESSURE_MPA=30
CONSUMPTION_LPM=80
# 提醒阈值（分钟）：剩10分钟提醒、剩5分钟报警
WARN_MIN=10
ALARM_MIN=5

# ========== 服务 ==========
PORT=3000
API_TOKEN=请设置一个随机字符串作为访问令牌

# 新版客户端使用短期会话和单位成员白名单。
WATCHDOG_SESSION_AUTH_REQUIRED=1
WATCHDOG_MEMBER_AUTH_REQUIRED=1
# 活跃设备每次续期后的空闲有效期（默认 8 小时），以及单次认证的绝对上限（默认 30 天）
WATCHDOG_SESSION_TTL_MS=28800000
WATCHDOG_SESSION_MAX_TTL_MS=2592000000
# 组织种子：真实姓名、消防站和单位验证码不要写入仓库。
# 复制 backend/seeds/org.example.json 为私有文件后填写，或只用下面的环境变量。
# 文件与环境变量同时存在时，非空的环境变量覆盖文件中的对应字段。
# WATCHDOG_ORG_SEED_FILE=/secure/watchdog-org.json
WATCHDOG_ORG_SEED_FILE=
# 可选：JSON 数组（[{"real_name":"张三","role":"manager"}]）或“张三:manager,李四”。
WATCHDOG_SEED_UNIT_MEMBERS=
WATCHDOG_SEED_UNIT_ID=
WATCHDOG_SEED_UNIT_NAME=
WATCHDOG_SEED_UNIT_CODE=
# 名单、消防站、专有热词：JSON 数组或逗号分隔。留空表示不从环境变量覆盖。
WATCHDOG_SEED_FIREFIGHTERS=
WATCHDOG_SEED_STATIONS=
WATCHDOG_SEED_HOTWORDS=

# 多设备关键写入门禁：先发布支持版本校验的 App，再切换为 1。0 仅用于升级过渡期。
WATCHDOG_ENTRY_VERSION_REQUIRED=0
