# ========== 豆包语音（火山引擎）==========
# 新版控制台创建应用后获取 APP Key：https://console.volcengine.com/speech/new
# 开通「语音识别大模型 - 流式语音识别」后，Resource ID 选择小时版 volc.bigasr.sauc.duration
VOLC_APP_KEY=
VOLC_ACCESS_TOKEN=
VOLC_RESOURCE_ID=volc.bigasr.sauc.duration

# ========== DeepSeek ==========
# https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 辅助问答专用模型（Responses API，支持服务端联网搜索；目前仅 deepseek-v4-flash）
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
# 辅助问答联网搜索开关：1 开启（默认），0 关闭
CHAT_SEARCH_ENABLED=1

# ========== CloudBase PostgreSQL（CloudBase 云托管使用）==========
# 新建 PG 模式环境后，云托管运行时通过 PostgREST 访问 PostgreSQL。
WATCHDOG_DB_DRIVER=cloudbase
CLOUDBASE_ENV_ID=
# PG 模式 service_role API Key，只放在云托管环境变量，不要进入 App 或仓库
# CloudBase 控制台“选择 API Key”注入时默认变量名为 CLOUDBASE_APIKEY；本地可使用下方别名
CLOUDBASE_API_KEY=
# 可选：不填时按 CLOUDBASE_ENV_ID 自动推导
CLOUDBASE_REST_BASE_URL=
CLOUDBASE_REST_TIMEOUT_MS=10000
CLOUDBASE_REST_MAX_RETRIES=2
# 仅执行 npm run db:migrate 时需要，不能配置到云托管运行时
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=

# ========== 计算参数 ==========
# 气瓶容量(升)、满压(兆帕)、中等劳动强度消耗率(升/分钟)
CYLINDER_VOL_L=6.8
FULL_PRESSURE_MPA=30
CONSUMPTION_LPM=80
# 提醒阈值（分钟）：剩10分钟提醒、剩5分钟报警
WARN_MIN=10
ALARM_MIN=5

# ========== 服务 ==========
PORT=3000
API_TOKEN=请设置一个随机字符串作为访问令牌
